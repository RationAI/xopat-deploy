WS_CORS_ALLOW_CREDENTIALS=False
WS_CORS_ALLOW_ORIGINS=["*"]
WS_DEBUG=False
WS_DISABLE_OPENAPI=False
WS_MAPPER_ADDRESS=http://localhost:8050/v3/slides/storage?slide_id={slide_id}
WS_LOCAL_MODE=wsi_service.paths_mapper:PathsMapper
WS_ENABLE_VIEWER_ROUTES=True
# Memory containment for the single-worker WSI binary on a capped Colab VM.
# Several viewers (each multi-channel/multi-layer) decode many tiles
# concurrently; with no per-worker memory cap the VM OOM-kills the WSI
# process (SIGKILL, returncode -9), which then 500s every proxied request
# until run_server() respawns it. These keep resident memory down:
#   - few open slide handles, closed quickly when idle
#   - a hard ceiling on the pixels any single region request may allocate
#     (~3000x3000; tiles are small so they're unaffected, this only bounds
#     the pathological large-region case)
WS_INACTIVE_HISTO_IMAGE_TIMEOUT_SECONDS=60
WS_IMAGE_HANDLE_CACHE_SIZE=6
WS_MAX_RETURNED_REGION_SIZE=9000000
WS_MAX_THUMBNAIL_SIZE=500

# Auth
WS_API_V3_INTEGRATION=wsi_service.api.v3.integrations.disable_auth:DisableAuth
WS_IDP_URL=
WS_CLIENT_ID=wbs
WS_CLIENT_SECRET=dummy
WS_ORGANIZATION_ID=dummy_org
WS_AUDIENCE=org.empaia.no-auth.wbs
WS_OPENAPI_TOKEN_URL=
WS_OPENAPI_AUTH_URL=
WS_REWRITE_URL_IN_WELLKNOWN=
WS_REFRESH_INTERVAL=300

# Slides root. Must be an absolute path: WSI-Service resolves a relative value
# against its own working directory, which every launcher here sets to the
# directory holding the binary (required, since the service reads a relative
# `.env`). An empty value therefore means "the binary's directory", not the
# /data default. The pypi launcher rewrites this line on every run_server();
# the desktop installers rewrite it from the "Change slides folder" picker.
WS_DATA_DIR=

